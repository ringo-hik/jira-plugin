{
  "name": "jira-plugin",
  "displayName": "Simple JIRA Plugin",
  "description": "Simple JIRA Server integration - Just URL and PAT",
  "version": "1.0.0",
  "publisher": "se-khm",
  "icon": "images/icons/icon.png",
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/src/extension",
  "scripts": {
    "clean": "rm -rf ./out",
    "vscode:prepublish": "npm run compile",
    "compile": "npm run clean && tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "contributes": {
    "configuration": {
      "type": "object",
      "title": "Simple JIRA Configuration",
      "properties": {
        "jira-plugin.baseUrl": {
          "type": "string",
          "description": "Your JIRA Server URL",
          "default": ""
        },
        "jira-plugin.username": {
          "type": "string",
          "description": "Your JIRA user ID",
          "default": ""
        },
        "jira-plugin.workingProject": {
          "type": "string",
          "description": "Current working project key",
          "default": ""
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "issuesExplorer",
          "title": "Jira",
          "icon": "images/icons/jira-explorer-icon.svg"
        }
      ]
    },
    "views": {
      "issuesExplorer": [
        {
          "id": "issuesExplorer",
          "name": "ISSUES"
        }
      ]
    },
    "commands": [
      {
        "command": "jira-plugin.setupCredentials",
        "title": "Setup JIRA Connection",
        "category": "Jira-plugin"
      },
      {
        "command": "jira-plugin.refresh",
        "title": "Refresh",
        "category": "Jira-plugin",
        "icon": {
          "light": "images/icons/light/refresh.svg",
          "dark": "images/icons/dark/refresh.svg"
        }
      },
      {
        "command": "jira-plugin.setWorkingProject",
        "title": "Change Project",
        "category": "Jira-plugin"
      },
      {
        "command": "jira-plugin.openIssue",
        "title": "Open in Browser",
        "category": "Jira-plugin"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "jira-plugin.refresh",
          "when": "view == issuesExplorer",
          "group": "navigation"
        },
        {
          "command": "jira-plugin.setWorkingProject",
          "when": "view == issuesExplorer",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "jira-plugin.openIssue",
          "when": "view == issuesExplorer && viewItem == jiraIssue",
          "group": "inline"
        }
      ]
    }
  },
  "devDependencies": {
    "@types/node": "^14.11.2",
    "@types/vscode": "1.31",
    "typescript": "^3.9.7"
  },
  "dependencies": {
    "jira-connector": "^3.1.0"
  }
}