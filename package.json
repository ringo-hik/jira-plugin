{
  "name": "jira-plugin",
  "displayName": "JIRA Remote Control",
  "description": "Simple JIRA issue viewer and browser launcher",
  "version": "2.0.0",
  "publisher": "se-khm",
  "icon": "images/icons/icon.png",
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/src/extension",
  "scripts": {
    "clean": "rm -rf ./out",
    "vscode:prepublish": "npm run compile",
    "compile": "npm run clean && tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "contributes": {
    "configuration": {
      "type": "object",
      "title": "JIRA Plugin Configuration",
      "properties": {
        "jira-plugin.baseUrl": {
          "type": "string",
          "description": "Your JIRA Server URL (e.g., https://jira.company.com)",
          "default": ""
        },
        "jira-plugin.username": {
          "type": "string",
          "description": "Your JIRA username or email",
          "default": ""
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "issuesExplorer",
          "title": "JIRA",
          "icon": "images/icons/jira-explorer-icon.svg"
        }
      ]
    },
    "views": {
      "issuesExplorer": [
        {
          "id": "issuesExplorer",
          "name": "Projects"
        }
      ]
    },
    "commands": [
      {
        "command": "jira-plugin.setupCredentials",
        "title": "Setup JIRA Connection",
        "category": "JIRA"
      },
      {
        "command": "jira-plugin.openSettings",
        "title": "Open Settings",
        "category": "JIRA"
      },
      {
        "command": "jira-plugin.refresh",
        "title": "Refresh",
        "category": "JIRA",
        "icon": {
          "light": "images/icons/light/refresh.svg",
          "dark": "images/icons/dark/refresh.svg"
        }
      },
      {
        "command": "jira-plugin.addProject",
        "title": "Add Project",
        "category": "JIRA",
        "icon": {
          "light": "images/icons/light/plus_nav.png",
          "dark": "images/icons/dark/plus_nav.png"
        }
      },
      {
        "command": "jira-plugin.openIssue",
        "title": "Open in Browser",
        "category": "JIRA"
      },
      {
        "command": "jira-plugin.searchIssues",
        "title": "Search Issues",
        "category": "JIRA",
        "icon": {
          "light": "images/icons/light/gear.svg",
          "dark": "images/icons/dark/gear.svg"
        }
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "jira-plugin.addProject",
          "when": "view == issuesExplorer",
          "group": "navigation@1"
        },
        {
          "command": "jira-plugin.searchIssues",
          "when": "view == issuesExplorer",
          "group": "navigation@2"
        },
        {
          "command": "jira-plugin.refresh",
          "when": "view == issuesExplorer",
          "group": "navigation@3"
        }
      ],
      "view/item/context": [
        {
          "command": "jira-plugin.openIssue",
          "when": "view == issuesExplorer && viewItem == issue"
        }
      ]
    }
  },
  "devDependencies": {
    "@types/node": "^14.11.2",
    "@types/vscode": "^1.74.0",
    "typescript": "^4.5.0"
  },
  "dependencies": {
    "axios": "^1.3.0"
  }
}